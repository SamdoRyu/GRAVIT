# GRAVIT local development. Copy to .env (git-ignored) and change the passwords.
# Read by compose.yaml (Docker Compose) and by Spring Boot (backend/src/main/resources/application.yaml).
# No quotes around values. Never put real secrets in this file.

# --- Local MySQL 8.x (compose.yaml) ---
MYSQL_DATABASE=gravit
MYSQL_USER=gravit
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root
# Host port for MySQL. Change if 3306 is taken by a local MySQL install.
MYSQL_PORT=3306

# --- Frontend dev (Vite) ---
# Vite reads this from the shell, not from this file: $env:API_PORT=8081 before npm run dev.
# API_PORT=8080

# --- Backend (Spring) ---
# Allowed Origin for write requests (POST/PUT/PATCH/DELETE). Defaults to this value when unset.
APP_ORIGIN=http://localhost:5173
# Approved instructor accounts: comma-separated GitHub user IDs (numbers, not login names). Empty = no instructors.
INSTRUCTOR_GITHUB_USER_IDS=
# Security-review ID/PW login (P15). Keep false unless this environment is for the security review.
REVIEW_LOGIN_ENABLED=false
# GitHub login — the GitHub App's OAuth client. Uncomment and fill locally; never commit real values.
# Callback URL to register in the GitHub App: http://localhost:5173/login/oauth2/code/github (Vite dev).
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=
# GitHub App name as in https://github.com/apps/<slug> — builds the "install the app" link. Empty = no link.
# GITHUB_APP_SLUG=

# --- Later (GitHub App / auth) — names from 환경 변수 가이드, not read by any code yet ---
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# MASTER_ADMIN_GITHUB_LOGIN=
